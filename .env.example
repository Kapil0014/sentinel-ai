# Copy to .env and edit:  cp .env.example .env     (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored. NEVER commit real secrets. This file holds placeholders only.

# --- General -------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by the postgres container and to build DATABASE_URL in Compose) ------
# Use letters and digits only in the password: it is embedded in a URL.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=sentinel

# --- Used when running the backend directly on your machine (not in Compose) ---------------
# Inside Compose these are overridden to point at the "postgres" and "redis" containers.
DATABASE_URL=postgresql+psycopg://sentinel:change-me-dev-password@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
BROWSER_WORKER_URL=http://localhost:8081

# --- Security ------------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 characters. Production refuses placeholder values.
JWT_SECRET=replace-with-output-of-secrets-token-hex-32-command
CORS_ORIGINS=http://localhost:5173
# Hosts allowed to resolve to private addresses. Controlled demo only; MUST be empty in production.
ALLOWED_PRIVATE_HOSTS=demo-site

# --- LLM -----------------------------------------------------------------------------------
# "mock" needs no key and returns clearly-labelled canned output. "gemini" needs GEMINI_API_KEY.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Browser worker ------------------------------------------------------------------------
# Chromium's own sandbox. false is a DEVELOPMENT-ONLY default until the seccomp profile is
# verified on Docker Desktop (planned Week 2, see docs/security.md). Must be true in production.
CHROMIUM_SANDBOX=false

# --- Windows / WSL2 ------------------------------------------------------------------------
# Set true only if the repository lives on a Windows drive (C:\...) so file watching works.
# Strongly preferred: keep the repo inside the WSL filesystem (~/sentinel-ai) instead.
CHOKIDAR_USEPOLLING=false
